# AI-RailLink Frontend Environment Variables
# Copy to .env and configure your Supabase project keys

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anon Key (safe for client-side browser usage)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API URL (Node.js Gateway)
# Local: http://localhost:5000
# Production: https://raillink-xi.vercel.app or backend URL
VITE_API_URL=http://localhost:5000
