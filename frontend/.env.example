# AI-RailLink Frontend Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anon Key (safe for client-side browser usage)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API Gateway URL (Node.js Gateway / Render deployment)
# Local: http://localhost:5000
# Production: https://your-raillink-backend.onrender.com
VITE_API_URL=http://localhost:5000
