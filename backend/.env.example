# AI-RailLink Backend Environment Variables
PORT=5000
FRONTEND_URL=https://ai-raillink.vercel.app,http://localhost:3000,http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
NODE_ENV=production

# OpenAI API Configuration (Kept strictly on backend - Never exposed to frontend)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# Fast Local Mock AI Mode (true = offline local AI engine, false = OpenAI API with local fallback)
AI_MOCK_MODE=true
